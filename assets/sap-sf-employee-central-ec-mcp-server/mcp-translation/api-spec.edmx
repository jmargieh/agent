		<Schema Namespace="SFOData"
			xmlns="http://schemas.microsoft.com/ado/2008/09/edm"
			xmlns:sap="http://www.successfactors.com/edm/sap"
			xmlns:sf="http://www.successfactors.com/edm/sf">
			<EntityType Name="PerGlobalInfoCHN">
				<Key>
					<PropertyRef Name="country"/>
					<PropertyRef Name="personIdExternal"/>
					<PropertyRef Name="startDate"/>
				</Key>
				<Property Name="country" Nullable="false" Type="Edm.String" sap:creatable="false" sap:filterable="true" sap:label="country" sap:required="true" sap:sortable="true" sap:updatable="false" sap:upsertable="true" sap:visible="true"/>
				<Property MaxLength="100" Name="createdBy" Nullable="true" Type="Edm.String" sap:creatable="false" sap:filterable="true" sap:label="Created By" sap:required="false" sap:sortable="true" sap:updatable="false" sap:upsertable="false" sap:visible="true"/>
				<Property Name="createdDateTime" Nullable="true" Type="Edm.DateTimeOffset" sap:creatable="false" sap:filterable="true" sap:label="Created Date Time" sap:required="false" sap:sortable="true" sap:updatable="false" sap:upsertable="false" sap:visible="true"/>
				<Property Name="createdOn" Nullable="true" Type="Edm.DateTime" sap:creatable="false" sap:display-format="Date" sap:filterable="true" sap:label="Created On" sap:required="false" sap:sortable="true" sap:updatable="false" sap:upsertable="false" sap:visible="true"/>
				<Property Name="endDate" Nullable="true" Type="Edm.DateTime" sap:creatable="false" sap:display-format="Date" sap:filterable="true" sap:label="End Date" sap:required="false" sap:sortable="true" sap:updatable="false" sap:upsertable="true" sap:visible="true"/>
				<Property Name="genericDate1" Nullable="true" Type="Edm.DateTime" sap:creatable="false" sap:display-format="Date" sap:filterable="false" sap:label="Date of Marriage" sap:required="false" sap:sortable="false" sap:updatable="false" sap:upsertable="true" sap:visible="true"/>
