				<Property Name="genericDate2" Nullable="true" Type="Edm.DateTime" sap:creatable="false" sap:display-format="Date" sap:filterable="false" sap:label="Date Learned" sap:required="false" sap:sortable="false" sap:updatable="false" sap:upsertable="true" sap:visible="true"/>
				<Property Name="genericDate3" Nullable="true" Type="Edm.DateTime" sap:creatable="false" sap:display-format="Date" sap:filterable="false" sap:label=" Date of Separation from Military Service " sap:required="false" sap:sortable="false" sap:updatable="false" sap:upsertable="true" sap:visible="false"/>
